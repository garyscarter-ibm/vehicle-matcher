  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Retained policy data is read in place from server/gcsp, never copied into this module. -->
      <resource>
        <directory>${project.basedir}/../../server/gcsp/policy</directory>
        <targetPath>gcsp/policy</targetPath>
        <includes>
          <include>seed-v1.json</include>
          <include>reviewed/*.json</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../../server/gcsp/predict/records</directory>
        <targetPath>gcsp/policy/records</targetPath>
        <includes>
          <include>policy-definitions.json</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../../server/data/gcsp/comparison</directory>
        <targetPath>gcsp/comparison</targetPath>
        <includes>
          <include>process-only.json</include>
        </includes>
      </resource>
      <!-- Retained learned-model artifacts (FUCQ-476), read in place from docs/gcsp/models/artifacts. -->
      <resource>
        <directory>${project.basedir}/../../docs/gcsp/models/artifacts</directory>
        <targetPath>gcsp/learning/artifacts</targetPath>
        <includes>
          <include>*.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

