{
  "version": 1,
  "roots": [
    "blocks/vehicle-matcher/",
    "blocks/gcsp/",
    "blocks/demo-launcher/"
  ],
  "exclude": [
    "blocks/vehicle-matcher/ui.js",
    "blocks/vehicle-matcher/modes/question-ui.js",
    "blocks/vehicle-matcher/modes/result-card.js",
    "blocks/vehicle-matcher/modes/match-signal.js",
    "blocks/vehicle-matcher/modes/preview-feed.js",
    "blocks/vehicle-matcher/modes/brand-copy.js",
    "blocks/vehicle-matcher/fonts/",
    "blocks/demo-launcher/components.js",
    "blocks/gcsp/kit/presenter-bar.js",
    "blocks/gcsp/kit/activity-timeline.js",
    "blocks/gcsp/kit/stage-list.js",
    "blocks/gcsp/kit/action-menu.js",
    "blocks/gcsp/kit/stage-tracker.js",
    "blocks/gcsp/kit/task-list.js"
  ],
  "extensions": [
    ".js",
    ".mjs"
  ],
  "patterns": {
    "heading": {
      "re": "el\\('(p|h2)', 'vm-(kicker|title|lede)",
      "flags": "g",
      "use": "screenIntro({ kicker, title, lede }) (ui.js)"
    },
    "button": {
      "re": "el\\('(a|button)', 'vm-btn vm-btn-(primary|ghost)",
      "flags": "g",
      "use": "button({ label, variant, onClick, href }) (ui.js)"
    },
    "skeleton": {
      "re": "el\\('div', 'vm-skel[ ']",
      "flags": "g",
      "use": "skeleton(kind) / loadingScreen() (proposed, see COMPONENTS.md)"
    },
    "status-screen": {
      "re": "el\\('div', 'vm-screen vm-status'",
      "flags": "g",
      "use": "statusScreen({ kicker, title, message, actions }) (ui.js)"
    },
    "spec-pill": {
      "re": "el\\('span', 'vm-mingle-pill'",
      "flags": "g",
      "use": "specPills(car) (proposed, see COMPONENTS.md)"
    },
    "mini-card": {
      "re": "el\\('div', 'vm-mingle-card-(media|body|colour)'",
      "flags": "g",
      "use": "miniCarCard(car) (proposed, see COMPONENTS.md)"
    },
    "single-slider": {
      "re": "el\\('input', 'vm-slider-input'\\)",
      "flags": "g",
      "use": "a single option on renderRangeSlider (modes/question-ui.js)"
    },
    "experience-choice": {
      "re": "el\\('article', 'demo-experience-choice'",
      "flags": "g",
      "use": "experienceChoice() (blocks/demo-launcher/components.js)"
    },
    "brand-selector": {
      "re": "el\\('select', 'demo-brand-control'",
      "flags": "g",
      "use": "brandSelector() (blocks/demo-launcher/components.js)"
    },
    "presenter-bar": {
      "re": "el\\('details', 'gcsp-presenter-(?:bar|controls)",
      "flags": "g",
      "use": "presenterBar({ label, readback }) (blocks/gcsp/kit/presenter-bar.js)"
    },
    "activity-timeline": {
      "re": "el\\('section', 'gcsp-activity-timeline'",
      "flags": "g",
      "use": "activityTimeline({ events }) (blocks/gcsp/kit/activity-timeline.js)"
    },
    "stage-list": {
      "re": "el\\('section', 'gcsp-stage-list'",
      "flags": "g",
      "use": "stageList({ heading, stages }) (blocks/gcsp/kit/stage-list.js)"
    },
    "action-menu": {
      "re": "el\\('div', 'gcsp-action-menu'",
      "flags": "g",
      "use": "actionMenu({ label, items }) (blocks/gcsp/kit/action-menu.js)"
    },
    "stage-tracker": {
      "re": "el\\('section', 'gcsp-stage-tracker'",
      "flags": "g",
      "use": "stageTracker({ heading, stages }) (blocks/gcsp/kit/stage-tracker.js)"
    },
    "task-list": {
      "re": "el\\('section', 'gcsp-task-list'",
      "flags": "g",
      "use": "taskList({ heading, groups }) (blocks/gcsp/kit/task-list.js)"
    }
  },
  "stylesheets": [
