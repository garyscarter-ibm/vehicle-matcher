  <diagram id="wPzIfsWXvCVQO-DYsBWB" name="02 Shared recommendation target">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1540" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Separate runtimes · preserved recommendation semantics" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172a3a;fontSize=26;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The earlier shared-JavaScript extraction design is retained as source evidence. The migration shares contracts and parity evidence across Node and Java." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#172a3a;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1460" height="62" as="geometry" />
        </mxCell>
        <mxCell id="retail" value="&lt;b&gt;Used Cars · retained runtime&lt;/b&gt;&lt;br&gt;Existing EDS / browser frontend&lt;br&gt;Node recommendation core + retail policy&lt;br&gt;Current exports / routes / six brands / modes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#657786;fontColor=#172a3a;align=left;verticalAlign=middle;spacing=16;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="600" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gcsp" value="&lt;b&gt;GCSP · replacement runtime&lt;/b&gt;&lt;br&gt;Angular 21 screens / Java 21 Quarkus 3.x API&lt;br&gt;Java gates / evaluation / allocation / inference&lt;br&gt;No invocation of Node business services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8effc;strokeColor=#3366a6;fontColor=#172a3a;align=left;verticalAlign=middle;spacing=16;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="890" y="180" width="600" height="190" as="geometry" />
        </mxCell>
        <mxCell id="semantics" value="&lt;b&gt;Preserved semantic contracts + decision evidence&lt;/b&gt;&lt;br&gt;Exact stock identity and source provenance · complete candidates before grouping / truncation&lt;br&gt;Canonical versioned policy · hard / unknown gates before preference fit · deterministic ranking / tie-breaks&lt;br&gt;Pinned quotes · displayed values and outcomes preserved within defined numeric tolerances&lt;br&gt;Retail purchase terms and GCSP points/contribution remain distinct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eafa;strokeColor=#8662a1;fontColor=#172a3a;align=left;verticalAlign=middle;spacing=16;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="270" y="510" width="1000" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;UI reuse&lt;/b&gt;&lt;br&gt;Shared tokens / compatible primitives adapted into Angular&lt;br&gt;Angular owns GCSP screens, routes and controllers&lt;br&gt;Shared changes retain relevant Used Cars evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f3f1;strokeColor=#167d8d;fontColor=#172a3a;align=left;verticalAlign=middle;spacing=16;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="660" height="155" as="geometry" />
        </mxCell>
        <mxCell id="proof" value="&lt;b&gt;Proof boundaries&lt;/b&gt;&lt;br&gt;Frozen baseline e44ed08a… + reference cases&lt;br&gt;Source substitution through startup-selected Java ports&lt;br&gt;Native Node performance acceptance stays separate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#808080;fontColor=#172a3a;align=left;verticalAlign=middle;spacing=16;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="830" y="830" width="660" height="155" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Retain retail contracts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526777;fontColor=#263e50;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="retail" target="semantics">
