        <mxCell id="row-4-1" value="Send committed reservation-backed email; signed-in owned-offer link, durable retry/provider reference and actual delivery proof." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;rounded=0;spacing=17;" vertex="1" parent="1">
          <mxGeometry x="375" y="985" width="665" height="170" as="geometry" />
        </mxCell>
        <mxCell id="row-4-2" value="BMW-approved mail service. Graph/Exchange Online is a candidate; sender mailbox and Mail.Send authorisation required. Approved relay may substitute." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;rounded=0;spacing=17;" vertex="1" parent="1">
          <mxGeometry x="1040" y="985" width="670" height="170" as="geometry" />
        </mxCell>
        <mxCell id="row-4-3" value="Captured/Brevo baseline; port to Java. Both connected proofs need actual test delivery + OIDC return. Comparisons keep captured mail." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;rounded=0;spacing=17;" vertex="1" parent="1">
