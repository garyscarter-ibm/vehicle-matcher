        <mxCell id="mapping-foot" value="Updated 13 November: Java owns orchestration/receipts; providers own actual acknowledgement. Startup-selected substitutes, then BMW activation with contracts/access. No silent success; no completed integration claimed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;fontColor=#66788A;spacing=0;rounded=0;" vertex="1" parent="1">
