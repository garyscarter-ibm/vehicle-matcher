        <mxCell id="row-3-2" value="GCSP/ISA appointment functions; return completion queues UVDM disposal request in the walkthrough. Fleet updates, return and physical-outcome interfaces to confirm." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;rounded=0;spacing=17;" vertex="1" parent="1">
          <mxGeometry x="1040" y="815" width="670" height="170" as="geometry" />
        </mxCell>
        <mxCell id="row-3-3" value="Synthetic appointment/return adapters. Booking a plan does not change the current-car relationship." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;rounded=0;spacing=17;" vertex="1" parent="1">
          <mxGeometry x="1710" y="815" width="410" height="170" as="geometry" />
        </mxCell>
        <mxCell id="row-4-0" value="A5  Offer notifications" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F6FC;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=23;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;fontStyle=1;rounded=0;spacing=17;" vertex="1" parent="1">
