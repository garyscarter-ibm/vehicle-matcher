        <mxCell id="row-5-1" value="Intentional order requests from the Vehicle Ordering Team; Production response, confirmed future supply and subsequent actual release." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#D3DCE6;strokeWidth=2;fontColor=#172B4D;fontSize=21;fontFamily=Arial;align=left;verticalAlign=middle;spacing=20;rounded=0;spacing=17;" vertex="1" parent="1">
