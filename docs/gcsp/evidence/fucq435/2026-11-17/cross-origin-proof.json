{
  "productDefects": [
    {
      "id": "claim-hold-mode-local-rejected",
      "where": "Angular apps/gcsp-web/src/app/manual/manual.projection.ts manualSelection() vs Java ClaimRow.hold()",
      "evidence": "POST /manual/claim 200 returns hold.mode \"local\"; the validator accepts only \"new\" or \"replacement\", so isManualClaim fails and /gcsp/manual/review shows \"Outcome not confirmed\" instead of the held claim. Direct GET /manual/claim confirms holdState active, holdMode local (observations.claimReadAfterReview)."
    },
    {
      "id": "offer-read-sends-runId-query",
      "where": "Angular offers/offer.client.ts readOffer() vs Java OffersResource.offer()",
      "evidence": "Browser GET /offers/{id}?runId=run-1 gets 400 unsupported-query (\"Offers do not take query parameters.\") so every offer, known or not, shows \"Offer link incomplete\". The same unknown id without the query gets 404 offer-not-found (observations.directBare)."
    }
  ],
