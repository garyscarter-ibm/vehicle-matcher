{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "g61-field-ledger.v1",
  "title": "Offline G61 field ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "story",
    "purpose",
    "inputHashMeaning",
    "sources",
    "relation",
    "qualification",
    "retention",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "g61-field-ledger.v1"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "story": {
      "const": "FUCQ-58"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "inputHashMeaning": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "artifactSha256",
          "sourceDate",
          "observedAt",
          "dateBasis"
        ],
        "properties": {
          "id": {
            "enum": [
              "observation",
              "rules",
              "checklist",
              "registry",
              "next-path"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceDate": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "dateBasis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relation": {
      "const": {
        "candidateObservationId": "UK-OBS-004",
        "configuratorModelCode": "T5MJ",
        "independentlyMatchedVehicle": false,
        "independentlyMatchedProfile": false,
        "status": "unqualified",
        "basis": "Reported G61/i5/Touring and shared text do not independently join the supplied candidate to the model-scoped configurator family."
      }
    },
    "qualification": {
      "const": {
        "status": "unqualified",
        "registryEdited": false,
        "profileActivations": 0,
        "newSourceObservations": 0,
        "newConfigurations": 0,
        "historicalDistinctConfigurations": 3,
        "fiveWmiCoverageProved": false,
        "everySchemeModelCoverageProved": false
      }
    },
    "retention": {
      "const": {
        "allowed": "Arbitrary observation IDs, non-personal shared type/format facts, explicit artifact hashes and local source locators.",
        "excluded": "Real VINs, plates, individual serials, identifier hashes/URLs/captures and the individual observed position-nine check character."
      }
    },
    "rows": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "configuratorValue",
          "candidateValue",
          "status",
          "confidence",
          "evidence",
          "unresolvedRequirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "configuratorValue": {},
          "candidateValue": {},
          "status": {
            "enum": [
              "observed-literal",
              "reported-only",
              "unresolved",
              "context-only",
              "observed-arithmetic",
              "unqualified",
              "incompatible"
            ]
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "locator",
                "sourceDate",
                "observedAt",
                "dateBasis",
                "confidence"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "enum": [
                    "observation",
                    "rules",
                    "checklist",
                    "registry",
                    "next-path"
                  ]
                },
                "locator": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "value",
                    "contains"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "json-pointer",
                        "line"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contains": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "sourceDate": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "observedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dateBasis": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "unresolvedRequirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
