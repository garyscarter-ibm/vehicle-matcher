      "key": "choice.training.regularization",
      "value": 0.001,
      "unit": "dimensionless",
      "status": "assumed",
      "basis": "L2 penalty on average negative conditional log likelihood; small interpretable demo starting value.",
      "source": "docs/gcsp/models/fucq115-contract.md",
      "sourceDate": "2026-11-05"
    },
    {
      "key": "choice.training.split.v1",
      "value": {
        "lastTrainingCycleIndex": 1,
        "evaluationCycleIndices": [
          2,
          3
        ],
