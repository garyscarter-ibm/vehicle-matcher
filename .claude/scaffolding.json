  "test_stack": {
    "adapters": {
      "postgres": {
        "bin": "${GCSP_PG_BIN:-/opt/homebrew/opt/postgresql@17/bin}",
        "version": "17",
        "user": "gcsp",
        "prefix": "t",
        "fixed_names": [
          "gcsp_test_dev",
          "gcsp_test_running"
        ],
        "env": {
          "GCSP_TEST_DATABASE_URL": "jdbc:postgresql://127.0.0.1:{port}/{db}?user={user}",
          "GCSP_TEST_RUNNING_DATABASE_URL": "jdbc:postgresql://127.0.0.1:{port}/{db2}?user={user}",
          "PROOF_DB_USER": "{user}"
        }
      },
      "maven": {
        "java_home": "${JAVA_HOME:-/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home}",
        "module": "services/gcsp-api",
        "command": [
          "./mvnw",
          "-B",
          "test"
        ]
      },
      "node": {
        "node": "24.22.3",
        "npm": "11.19.1"
      },
      "build": {
        "api": {
          "command": [
            "/usr/bin/env",
            "MAVEN_OPTS=-Xmx512m",
            "./mvnw",
            "-B",
            "-q",
            "-DskipTests",
            "package"
          ],
          "cwd": "services/gcsp-api",
          "inputs": [
            "services/gcsp-api"
          ],
          "output": "services/gcsp-api/target/quarkus-app",
          "result": "quarkus-run.jar",
          "env_var": "PROOF_API_JAR",
          "tools": [
            "maven"
          ]
        },
        "web": {
          "command": [
            "npm",
            "run",
            "build"
          ],
          "cwd": "apps/gcsp-web",
          "inputs": [
            "apps/gcsp-web",
            "blocks/gcsp/shell"
          ],
          "output": "apps/gcsp-web/dist/gcsp-web/browser",
          "env_var": "PROOF_WEB_BROWSER",
          "node": "apps/gcsp-web"
        }
      }
    },
    "cache_keep": {
      "node": 2,
      "build-api": 3,
      "build-web": 3
    },
